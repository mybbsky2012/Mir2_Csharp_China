<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mir2MicroServer</AssemblyName>
    <RootNamespace>Mir2MicroServer</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Mir2 微端资源服务</Product>
    <AssemblyTitle>Mir2 微端资源服务（独立版）</AssemblyTitle>
    <!-- 只做资源下发，不引任何第三方包、也不引 Server.Library，保证可以单独拷走运行 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
